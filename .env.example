# KSGP Video Environment Variables
# Copy to .env and fill values. Never commit real secrets.

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-at-least-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Render will inject DATABASE_URL when you link Postgres)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Stripe (required for payments)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Site
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=noreply@ksgpvideo.com

# Email (optional for local – uses console backend if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis / Celery (optional)
REDIS_URL=redis://localhost:6379/0

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
YOUTUBE_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://ksgp-video.onrender.com
