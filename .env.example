# ============================================================
# Video Discovery Platform - Environment Variables
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# ---------- Django Core ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=vdp
POSTGRES_USER=vdp
POSTGRES_PASSWORD=vdp_secure_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://vdp:vdp_secure_password_change_me@db:5432/vdp

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Google OAuth (django-allauth) ----------
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- Stripe ----------
# https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CURRENCY=eur

# ---------- Frontend / CORS ----------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Email (development = console) ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@videodiscovery.example
# For production use SMTP or SendGrid/Mailgun:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ---------- Site ----------
SITE_ID=1
SITE_NAME=Video Discovery Platform
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,fa

# ---------- Security (production) ----------
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ---------- Optional: YouTube Data API (for channel verification only) ----------
# YOUTUBE_API_KEY=your-youtube-api-key
# Use only within official YouTube API Terms. Optional feature.

# ---------- Storage (dev = local, prod = S3) ----------
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-central-1

# ---------- Monitoring (optional) ----------
# SENTRY_DSN=
